// MaxScore Database Schema
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User Management
// ============================================

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Subscription
  tier           Tier    @default(FREE)
  subscriptionId String? // Stripe subscription ID
  customerId     String? // Stripe customer ID

  // Quota tracking (free tier)
  scansToday   Int       @default(0)
  lastScanDate DateTime?

  // Relations
  scans        Scan[]
  chatSessions ChatSession[]

  @@index([clerkId])
  @@index([tier])
  @@index([email])
}

// ============================================
// Scan & Analysis
// ============================================

model Scan {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  // Image storage
  imageUrl     String  // R2 signed URL (private)
  thumbnailUrl String? // R2 public URL

  // Processing
  status       ScanStatus @default(PENDING)
  processedAt  DateTime?
  errorMessage String?

  // Scores
  overallScore  Float?
  percentile    Int?
  featureScores Json? // {symmetry: 7.5, jawline: 6.2, ...}

  // Raw metrics (for debugging/improvement)
  rawMetrics Json?

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestions Suggestion[]
  chatSession ChatSession?

  @@index([userId, createdAt])
  @@index([status])
}

model Suggestion {
  id        String   @id @default(cuid())
  scanId    String
  createdAt DateTime @default(now())

  // Content
  feature     String // "jawline", "skin", etc.
  score       Float
  title       String
  description String   @db.Text
  tips        String[] // Array of actionable tips
  impact      String?

  // Priority
  priority Int @default(0) // 0 = low, 1 = medium, 2 = high

  // Relations
  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([feature])
}

// ============================================
// Chat / AI Conversations
// ============================================

model ChatSession {
  id        String   @id @default(cuid())
  scanId    String   @unique
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Limit tracking (MVP: 3 messages per session for free)
  messageCount Int @default(0)

  // Relations
  scan     Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  createdAt DateTime @default(now())

  // Content
  role    MessageRole
  content String      @db.Text

  // Tracking
  tokensUsed     Int?
  processingTime Int? // milliseconds

  // Relations
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ============================================
// Payments & Subscriptions
// ============================================

model PaymentEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  payload       Json
  processedAt   DateTime @default(now())

  @@index([type])
  @@index([stripeEventId])
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  stripeCustomerId  String   @unique
  stripeSubId       String   @unique
  status            String
  priceId           String
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([stripeCustomerId])
  @@index([status])
}

// ============================================
// Enums
// ============================================

enum Tier {
  FREE
  PRO
}

enum ScanStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}
